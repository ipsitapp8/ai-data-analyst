# Silt web UI (Streamlit). Installed by deploy/vultr/setup.sh.
# Listens on loopback only; Caddy forwards public traffic (HTTP and WebSocket) to it.
[Unit]
Description=Silt web UI (Streamlit)
After=network-online.target silt-api.service
Wants=network-online.target silt-api.service

[Service]
Type=simple
User=silt
Group=silt
# BACKEND_BASE_URL, APP_URL, APP_PASSWORD (the access gate). No LLM keys, no database credentials.
EnvironmentFile=/etc/silt/ui.env
# Production-only Streamlit settings (local development keeps tracebacks and reloads).
Environment=STREAMLIT_CLIENT_SHOW_ERROR_DETAILS=none
Environment=STREAMLIT_SERVER_FILE_WATCHER_TYPE=none
Environment=STREAMLIT_SERVER_HEADLESS=true
Environment=STREAMLIT_BROWSER_GATHER_USAGE_STATS=false
# The repository root, so .streamlit/config.toml is read.
WorkingDirectory=/opt/silt
ExecStart=/opt/silt/.venv/bin/python -m streamlit run frontend/Home.py --server.address 127.0.0.1 --server.port 8501
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
