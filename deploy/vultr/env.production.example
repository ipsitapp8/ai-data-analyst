# Reference for the three environment files deploy/vultr/setup.sh creates. systemd format: KEY=value, comments only
# on their own line. Never commit real values.
# setup.sh generates the secrets marked (generated); you fill in the ones marked (you).

# ---------------- /etc/silt/api.env  (root:silt 0640) -- the API only ----------------
# (you) Planner, Executor, Dashboard
GEMINI_API_KEY=
# (you) Critic, and fallback provider (Groq by default)
LLAMA_API_KEY=
# (generated) keeps sessions valid across restarts
JWT_SECRET_KEY=
# (generated) postgresql://silt:<password>@127.0.0.1:5433/silt
DATABASE_URL=
# (generated) the public address; https://<domain> once a domain is set up
APP_URL=http://<server-ip>
# (generated) same as APP_URL
CORS_ALLOWED_ORIGINS=
DATA_DIR=/srv/silt/data
UPLOADS_DIR=/srv/silt/data/uploads
WORKSPACES_DIR=/srv/silt/workspaces
# isolated containers for AI-generated code; never "subprocess" on a public server
SANDBOX_BACKEND=docker
SANDBOX_ALLOW_UNSAFE_SUBPROCESS=false
SANDBOX_IMAGE=ai-data-analyst-sandbox:latest
# leave empty: Docker's default runtime under the rootless daemon. setup.sh refuses a value that is not a runtime
# of the sandbox daemon, and never sets one itself (gVisor would drop the limits under rootless Docker, see README)
SANDBOX_DOCKER_RUNTIME=
# (generated) unix:///run/user/<silt uid>/docker.sock -- the ROOTLESS daemon
DOCKER_HOST=
# (generated) /run/user/<silt uid>
XDG_RUNTIME_DIR=
HOME=/srv/silt/home
# concurrent analyses; each sandbox run is capped at 512 MB and 1 CPU
JOB_WORKERS=2
# optional per-run LLM cost cap
RUN_MAX_COST_USD=
# optional, invite emails: SMTP_USER=, SMTP_PASSWORD=, SMTP_FROM=

# ---------------- /etc/silt/ui.env  (root:silt 0640) -- the web UI only ----------------
BACKEND_BASE_URL=http://127.0.0.1:8000
APP_URL=http://<server-ip>
# (generated) the shared access password in front of the whole site (gated signup)
APP_PASSWORD=
# wrong guesses per visitor address ...
APP_PASSWORD_MAX_FAILURES=8
# ... within this many seconds, before that address is locked out for a while
APP_PASSWORD_WINDOW_SECONDS=600

# ---------------- /etc/silt/compose.env  (root 0600) -- Postgres ----------------
# (generated)
POSTGRES_PASSWORD=
