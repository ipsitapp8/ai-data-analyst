# Copy this file to .env and fill in your key.
# Get a Gemini API key at https://aistudio.google.com/apikey

GEMINI_API_KEY=your-gemini-api-key-here
# Flash, not Pro -- Pro models return 429 "limit: 0" on the free tier.
GEMINI_MODEL=gemini-2.5-flash
# Bounded retry-with-backoff on a 429 (free-tier per-minute cap), tried before
# failing over to Llama -- most 429s clear within a retry or two.
GEMINI_RATE_LIMIT_RETRIES=2
GEMINI_RATE_LIMIT_MAX_WAIT_SECONDS=30

# Second model, used only by the Critic agent for independent verification --
# a genuinely different model family catches different mistakes than the same
# model re-checking its own work.
#
# This must be an LLM *inference* key. NOTE: a LlamaCloud / LlamaIndex key
# (starts with "llx-") will NOT work -- that's a document-parsing/RAG service,
# not a model API. Working options (all OpenAI-compatible):
#   Groq (free tier):  LLAMA_BASE_URL=https://api.groq.com/openai/v1
#                      LLAMA_MODEL=llama-3.3-70b-versatile        key: gsk_...
#   Meta Llama API:    LLAMA_BASE_URL=https://api.llama.com/compat/v1/
#                      LLAMA_MODEL=Llama-4-Maverick-17B-128E-Instruct-FP8
#   OpenRouter:        LLAMA_BASE_URL=https://openrouter.ai/api/v1
#                      LLAMA_MODEL=meta-llama/llama-3.3-70b-instruct   key: sk-or-...
#
# If this key is missing or invalid the Critic falls back to Gemini and the
# audit trail records that the check was NOT cross-model.
LLAMA_API_KEY=your-llama-api-key-here
LLAMA_MODEL=Llama-4-Maverick-17B-128E-Instruct-FP8
LLAMA_BASE_URL=https://api.llama.com/compat/v1/

# "docker" is the isolation boundary for AI-generated code: no network, read-only
# filesystem, no capabilities, resource limits, one fresh container per run.
# "subprocess" runs that code as a plain process on this machine. It is NOT a
# security boundary and is refused unless SANDBOX_ALLOW_UNSAFE_SUBPROCESS=true.
# If the configured sandbox is unavailable, analyses that need generated code
# are refused -- nothing falls back to a weaker runner.
SANDBOX_BACKEND=docker
# Development on your own machine only, with data you trust:
SANDBOX_ALLOW_UNSAFE_SUBPROCESS=false
# Optional OCI runtime for the Docker sandbox, e.g. runsc (gVisor):
SANDBOX_DOCKER_RUNTIME=
SANDBOX_IMAGE=ai-data-analyst-sandbox:latest
SANDBOX_TIMEOUT_SECONDS=60
SANDBOX_MEMORY_LIMIT=512m
SANDBOX_CPU_LIMIT=1

MAX_EXECUTOR_RETRIES=3
MAX_CRITIC_REVISIONS=1

BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BACKEND_BASE_URL=http://127.0.0.1:8000

# --- Database ---
# Leave unset for local dev: falls back to the SQLite file at DB_PATH, exactly
# as before. Set this to a Postgres URL for production (or to test the
# Postgres path locally via `docker compose up -d postgres`, which listens on
# host port 5433 to avoid colliding with any native Postgres already on 5432):
#   DATABASE_URL=postgresql://silt:silt@localhost:5433/silt
# On Postgres, schema migrations run via Alembic (backend/alembic/) instead of
# the SQLite-only additive migration in app/database.py -- both run
# automatically on startup either way, so no separate manual step is needed.
DATABASE_URL=

# --- Deployment ---
# Shared password for the Streamlit gate. Leave empty to disable the gate entirely
# (correct for local dev). Set this as a Space secret in the hosted deployment.
APP_PASSWORD=

# --- Auth (per-user login, on top of the shared APP_PASSWORD gate above) ---
# Signs JWT session tokens. Leave empty for local dev (a random key is generated
# per process, so sessions just don't survive a restart) -- but set a real one
# for any real deployment, since a restart would otherwise log everyone out and
# multiple workers wouldn't agree on tokens at all.
JWT_SECRET_KEY=
JWT_EXPIRE_MINUTES=10080

# --- Hardening ---
# Comma-separated browser origins allowed to call the API directly. Empty
# means "*" (today's default) -- fine for the shipped topology, where the
# Streamlit frontend calls the API server-side and no browser ever makes a
# cross-origin request to it. Lock this down if you expose the API itself.
CORS_ALLOWED_ORIGINS=
# Rejects a dataset upload larger than this (bytes) before it's fully read
# into memory/disk.
MAX_UPLOAD_BYTES=209715200
# DEBUG/INFO/WARNING/ERROR. INFO is plenty outside active debugging.
LOG_LEVEL=INFO

# --- Outbound email (team invites) ---
# Gmail SMTP by default. SMTP_PASSWORD is a 16-character Gmail "App Password"
# (Google Account -> Security -> 2-Step Verification -> App Passwords) --
# NOT your Gmail login password, and Google only lets you generate one once
# 2-Step Verification is turned on. Leave both empty to disable sending
# entirely: invites still create the pending membership, they just don't
# email anyone about it.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Defaults to SMTP_USER if left empty.
SMTP_FROM=
# Public URL of the Streamlit frontend -- used only to build the link inside
# invite emails.
APP_URL=http://localhost:8501

# Subprocess-fallback hardening. SANDBOX_RUN_AS_USER drops agent-generated code to
# an unprivileged account (POSIX, needs root); the Docker image creates `sandbox`
# for exactly this. Empty means no drop -- fine locally, not on a public box.
SANDBOX_RUN_AS_USER=
SANDBOX_MAX_OUTPUT_BYTES=256m
# Opt-in RLIMIT_AS. Leave empty unless tested: numpy/OpenBLAS reserve enough
# virtual memory that a tight cap makes `import pandas` fail outright.
SANDBOX_ADDRESS_SPACE_LIMIT=

# Path overrides. The deployment points WORKSPACES_DIR at a tree the sandbox user
# owns, well away from DATA_DIR (which holds app.db and the raw uploads).
# DATA_DIR=
# UPLOADS_DIR=
# WORKSPACES_DIR=
# DB_PATH=

# Scheduled re-runs (in-process APScheduler). Disable with false; tick = how often due analyses are checked.
SCHEDULER_ENABLED=true
SCHEDULER_TICK_SECONDS=60

# --- RAG over past analyses ---
# Planner retrieves similar earlier analyses (same team + dataset) as context.
RAG_ENABLED=true
EMBEDDING_MODEL=gemini-embedding-001
RAG_TOP_K=3
RAG_MIN_SIMILARITY=0.6

# --- Durable jobs (docs/PLATFORM.md section 2) ---
# Worker threads per API process (0 = accept and queue jobs but run none here).
JOB_WORKERS=2
# Attempts per job, including recovery after a restart interrupted it.
JOB_MAX_ATTEMPTS=2
# Wall-clock limit per job, in seconds.
JOB_DEADLINE_SECONDS=900
# A worker's lease. A job whose lease expired is recovered by another worker.
JOB_LEASE_SECONDS=60
# Queued + running analyses allowed per team.
JOB_TEAM_MAX_ACTIVE=5

# --- Per-run budgets (0 = unlimited) ---
RUN_MAX_LLM_CALLS=40
RUN_MAX_SANDBOX_RUNS=30
RUN_MAX_COST_USD=0

# --- Providers ---
# false = if Gemini fails the run fails, instead of continuing on Llama.
LLM_FAILOVER_ENABLED=true
# USD per 1M tokens as "input,output". Used only for cost estimates in the run trace.
LLM_PRICE_GEMINI=0.30,2.50
LLM_PRICE_LLAMA=0.20,0.60

# --- Retention ---
# Leftover sandbox workspaces older than this are deleted. Database records never are.
RETENTION_WORKSPACE_DAYS=7

# --- Alerts ---
ALERT_DELIVERY_MAX_ATTEMPTS=3
ALERT_DELIVERY_RETRY_SECONDS=300

# --- Data quality defaults (each dataset can override them in the UI) ---
DQ_MIN_SAMPLE=100
DQ_PSI_WARN=0.1
DQ_PSI_HIGH=0.25

# --- Verification ---
# Extra relative tolerance when matching a displayed figure to a computed one.
# 0 = display precision only.
VERIFY_REL_TOLERANCE=0
