.env
__pycache__/
*.pyc
.venv/
venv/
backend/data/uploads/*
backend/data/workspaces/*
backend/data/app.db
backend/data/app.db.bak-*
!backend/data/uploads/.gitkeep
!backend/data/workspaces/.gitkeep
.streamlit/secrets.toml

# Raw third-party datasets are obtained from their publishers and never committed;
# their manifest and README are tracked. See training/data/raw/huggingface/README.md.
training/data/raw/**/*.parquet
training/data/raw/**/*.zip
training/data/raw/**/*.sqlite
training/data/raw/spider_official/spider_data/
# Built from those datasets (CC BY-SA 4.0): regenerated by training/scripts, not committed.
training/data/eval/**/tables/
training/data/eval/**/*.jsonl
# Evaluation cases built from Spider (CC BY-SA 4.0): regenerated by backend/evals/build_spider_cases.py.
backend/evals/cases/spider_*.json

# Local-only: macOS metadata, model weights, training datasets, web build output and secrets.
.DS_Store
training/adapters/
training/data/
web/node_modules/
web/.next/
web/.env.local
